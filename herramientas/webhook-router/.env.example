# ======================================================================
# WEBHOOK GATEWAY - ENVIRONMENT CONFIGURATIONS TEMPLATE
# ======================================================================
# Copy this file to a new file named '.env' and fill in your values.
# Leave webhook/credential values empty to run the Gateway in safe
# "Console Simulation Mode" for testing and diagnostics.
# ======================================================================

# --- SECURITY ---
# Secure cryptographic authorization token required by clients
GATEWAY_TOKEN=my_super_secure_secret_token

# --- NOTIFICATION CHANNELS (OPTIONAL) ---
# Telegram Bot Integration settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook Integration settings
DISCORD_WEBHOOK_URL=

# Slack Webhook Integration settings
SLACK_WEBHOOK_URL=

# --- REMOTE SSH AUTO-REMEDIATION TARGETS (OPTIONAL) ---
# Global default destination for SSH command orchestration recovery
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USERNAME=admin
# Provide either password OR private key file path (or both if passphrase is used)
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=
SSH_PRIVATE_KEY_PASSPHRASE=

# --- EVENT ROUTING CORE ENGINE SETTINGS ---
# Time window (in seconds) to suppress duplicate alert floods (Default: 5 mins)
DEDUPLICATION_WINDOW_SECONDS=300

# Periodic interval (in seconds) to dispatch lower-severity digests (Default: 1 hour)
# Set to shorter values (e.g. 60) for testing
DIGEST_INTERVAL_SECONDS=3600

# --- LOG FILES ROTATION SETTINGS ---
# Maximum file capacity threshold in bytes before log file rotation occurs.
# Set LOG_ROTATION_MAX_BYTES to 0 to disable rotation and retain ALL logs infinitely without deletion.
LOG_ROTATION_MAX_BYTES=5242880

# Maximum number of rotated log file backups to retain (e.g. 5 means keeping up to 5 history files)
LOG_ROTATION_BACKUP_COUNT=5
